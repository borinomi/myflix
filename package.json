{
  "name": "myflix",
  "productName": "MyFlix",
  "version": "1.0.0",
  "description": "Video Kiosk Application",
  "main": "electron/main.js",
  "type": "module",
  "author": "MyFlix",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:thumbnail": "node server/test-thumbnail.js",
    "electron:dev": "concurrently \"npm run server\" \"npm run client\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npx electron-builder --win nsis",
    "electron:build:dir": "npm run build && npx electron-builder --win dir"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
    "iconv-lite": "^0.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "video.js": "^8.23.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.myflix.app",
    "productName": "MyFlix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "!server/cache/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MyFlix-${version}-Setup.exe"
    },
    "asar": false
  }
}
